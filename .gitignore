# Personal editor settings (contain machine-specific paths)
.vscode/settings.json

# Generated web build served locally
/build/

# ---- Secrets & per-developer Firebase config (never commit) ----
# Generate locally with `flutterfire configure` (see README).
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json
macos/firebase_app_id_file.json
.firebaserc
.env
.env.*
*.keystore
*.jks
android/key.properties
**/service-account*.json

# Claude Code: personal settings and locally installed third-party skills
# (impeccable, ponytail, ui-ux-pro-max, taste-skill, no-ai-design-slop).
# They are tools, not part of the app; reinstall them locally if needed.
.claude/settings.local.json
.claude/skills/

# Impeccable scratch: device screenshots (contain personal account details),
# throwaway mockups and question pages. DESIGN.md, PRODUCT.md and
# .impeccable/design.json are kept.
.impeccable/review/
.impeccable/mocks/
.impeccable/questions/
.impeccable/config.local.json
